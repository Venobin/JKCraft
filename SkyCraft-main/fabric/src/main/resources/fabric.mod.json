{
  "schemaVersion": 1,
  "id": "skycraft",
  "version": "${version}",
  "name": "JKCraft",
  "description": "Play Jedi Academy with Minecraft physics, inventory and building.",
  "authors": ["chasmlol"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "main": ["dev.skycraft.SkyCraft"],
    "client": ["dev.skycraft.client.SkyCraftClient"]
  },
  "mixins": [
    "skycraft.mixins.json",
    { "config": "skycraft.client.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
